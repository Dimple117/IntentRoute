# Copy this file and rename it to .env
# Fill in your PostgreSQL password below

# Your password as-is:       pzqm123#$
# URL-encoded password:       pzqm123%23%24
#   # → %23
#   $ → %24

DATABASE_URL=postgresql://postgres:pzqm123%23%24@localhost:5432/intentroute

# ── Email (Gmail SMTP) — used to send password-reset codes ──────────────────
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password:      https://myaccount.google.com/apppasswords
#    App: "Mail"  Device: "Other" → name it "IntentRoute". Google gives you a
#    16-character password — paste it below with no spaces.
# If you leave these blank, reset codes are returned directly in the API
# response instead (so local dev still works without a real inbox).
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
GMAIL_FROM_NAME=IntentRoute
